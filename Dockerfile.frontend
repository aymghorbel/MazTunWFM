# Multi-stage build for React frontend with PWA support
FROM node:18-alpine AS builder

WORKDIR /app

ARG REACT_APP_API_URL=/api
ENV REACT_APP_API_URL=$REACT_APP_API_URL

# Install dependencies
COPY package*.json ./
RUN npm install

# Copy source files
COPY mazarine-timesheet-v5.jsx src/App.js
COPY src/index.js src/index.js
COPY src/api.js src/api.js
COPY src/service-worker.js src/service-worker.js
COPY src/serviceWorkerRegistration.js src/serviceWorkerRegistration.js

# Copy public assets (index.html, manifest.json)
COPY public/ public/

# Generate PNG icons (pure Node.js, no extra deps)
COPY generate-icons.js ./
RUN node generate-icons.js

# Build the React application
RUN npm run build

# Production stage
FROM nginx:alpine

RUN apk add --no-cache openssl && \
    mkdir -p /etc/nginx/ssl && \
    openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
      -keyout /etc/nginx/ssl/key.pem \
      -out /etc/nginx/ssl/cert.pem \
      -subj "/C=TN/O=Mazarine Energy/CN=mazarine"

COPY --from=builder /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80 443
CMD ["nginx", "-g", "daemon off;"]
