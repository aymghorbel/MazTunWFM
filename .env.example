# ─────────────────────────────────────────────────────────────────────────────
# MazTunWFM — Environment Variables Template
# Copy to .env and fill in your values. Never commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=db                              # 'db' for Docker Compose; Azure flexible server FQDN for production
DB_PORT=5432
DB_NAME=mazarine
DB_USER=postgres                        # Use 'mazadmin' on Azure PostgreSQL Flexible Server
DB_PASSWORD=ChangeMeStrong123!
DB_SSL=false                            # Set to 'true' for Azure Database for PostgreSQL

# ── JWT Secret (64+ random characters, never share) ───────────────────────────
JWT_SECRET=replace-with-64-random-characters-minimum

# ── CORS: comma-separated list of allowed frontend origins ────────────────────
# Local:       http://localhost:3005
# Azure:       https://<app>.azurestaticapps.net
# Both:        https://<app>.azurestaticapps.net,http://localhost:3005
CORS_ORIGIN=http://localhost:3005

# ── Azure Entra ID SSO ────────────────────────────────────────────────────────
# Register an App in Entra ID (Azure AD), then fill these in.
# Platform: Single-page application (SPA), Redirect URI: your Static Web App URL
# No client secret needed — backend validates tokens via public JWKS endpoint.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# ── Azure Blob Storage ────────────────────────────────────────────────────────
# Get connection string from: Storage Account -> Access keys -> Connection string
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_UPLOADS=uploads
AZURE_STORAGE_CONTAINER_EXPORTS=exports
AZURE_STORAGE_CONTAINER_BACKUPS=backups

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND build-time variables (set in CI/CD vars or local .env.local)
# ─────────────────────────────────────────────────────────────────────────────

# Full URL of the backend API (Azure Web App URL in production)
REACT_APP_API_URL=http://localhost:3001

# Entra ID — same IDs as above; leave blank to hide "Sign in with Microsoft"
REACT_APP_AZURE_CLIENT_ID=
REACT_APP_AZURE_TENANT_ID=
